# =============================================================================
# MatIQ environment reference
# =============================================================================
# Real values live in git-ignored files or in your CI / EAS / Supabase
# secret stores - never in the repository.
#
#   apps/mobile/.env            -> PUBLIC values compiled into the app
#   supabase/functions/.env     -> SERVER secrets for Edge Functions
#
# See apps/mobile/.env.example and supabase/functions/.env.example for the
# per-target templates, and docs/SECURITY_AND_DEPLOYMENT.md for details.

# -----------------------------------------------------------------------------
# Mobile app (public - anything EXPO_PUBLIC_* is readable by anyone who has the app)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1
EXPO_PUBLIC_FUNCTIONS_URL=https://your-api-function.example
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
EXPO_PUBLIC_TLS_PINS=
EXPO_PUBLIC_TLS_PINS_EXPIRE=
EXPO_PUBLIC_LEGAL_ENTITY=MatIQ
EXPO_PUBLIC_SUPPORT_EMAIL=privacy@example.com
EXPO_PUBLIC_DMCA_AGENT_NAME=
EXPO_PUBLIC_DMCA_AGENT_ADDRESS=
EXPO_PUBLIC_DMCA_AGENT_EMAIL=
EXPO_PUBLIC_DMCA_AGENT_PHONE=

# -----------------------------------------------------------------------------
# Edge Functions (secret - set with `supabase secrets set`)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Or any other AI: AI_PROVIDER (openai, google, xai, openrouter, groq, mistral,
# together, custom), AI_API_KEY, AI_MODEL and, for custom, AI_BASE_URL.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=medium
ANALYSIS_MAX_FRAMES=240
ANALYSIS_FRAMES_PER_REQUEST=20
ANALYSIS_CONCURRENCY=3
MATIQ_KEK_CURRENT=1
MATIQ_KEK_V1=
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Never put these anywhere in the app or the repository:
#   CLERK_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, database connection strings
#   and passwords, KEKs, AI provider keys,
#   signing keystores, App Store Connect / Play Console credentials.
# -----------------------------------------------------------------------------
