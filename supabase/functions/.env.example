# Edge Function secrets.
#   Local:  cp supabase/functions/.env.example supabase/functions/.env
#           npm run functions:serve
#   Hosted: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase runtime; do not set them here.

# Platform AI key (used when a user has not stored their own key).
ANTHROPIC_API_KEY=

# Analysis tuning (defaults shown).
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=medium
ANALYSIS_MAX_FRAMES=240
ANALYSIS_FRAMES_PER_REQUEST=20
ANALYSIS_CONCURRENCY=3

# Key-encryption keys for stored BYOK API keys (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Keep old versions set until scripts/rotate-api-key-kek.ts reports 0 rows.
MATIQ_KEK_CURRENT=1
MATIQ_KEK_V1=

# Comma-separated browser origins allowed by CORS. Leave empty for the
# native app only (native apps do not send an Origin header).
ALLOWED_ORIGINS=
