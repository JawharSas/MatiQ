# Copy to apps/mobile/.env (git-ignored) or define in EAS environment variables.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle and is
# therefore PUBLIC. Only put values here that are safe for anyone to read.
# Never put the Clerk secret key (sk_...), the database connection string,
# AI provider keys or KEKs here.

# Neon Data API URL (Neon Console > the branch > Data API) and the address of
# the `api` Neon Function. Both are public: every request carries the user's
# Clerk session token, and Row Level Security protects the data.
EXPO_PUBLIC_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1
EXPO_PUBLIC_FUNCTIONS_URL=https://your-api-function.example
# Clerk publishable key (Clerk Dashboard > API keys). Public by design.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# TLS public-key pins for the Data API host: comma-separated base64 SHA-256
# hashes of the certificate chain's SubjectPublicKeyInfo. At least two
# (a primary and a backup); see docs/SECURITY_AND_DEPLOYMENT.md for how to
# compute them. Leave empty to disable pinning (development only).
EXPO_PUBLIC_TLS_PINS=
# Optional yyyy-MM-dd after which pins stop being enforced (fail-open safety
# net for users who never update the app).
EXPO_PUBLIC_TLS_PINS_EXPIRE=

# Shown in the Privacy Policy / Terms of Service screens.
EXPO_PUBLIC_LEGAL_ENTITY=MatIQ
EXPO_PUBLIC_SUPPORT_EMAIL=privacy@example.com

# Designated agent for copyright (DMCA) notices, exactly as registered with
# the U.S. Copyright Office at https://dmca.copyright.gov (public by law).
# Name and email default to the legal entity and support email above.
EXPO_PUBLIC_DMCA_AGENT_NAME=
EXPO_PUBLIC_DMCA_AGENT_ADDRESS=
EXPO_PUBLIC_DMCA_AGENT_EMAIL=
EXPO_PUBLIC_DMCA_AGENT_PHONE=
