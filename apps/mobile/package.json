{
  "name": "@matiq/mobile",
  "version": "1.6.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "bundle:check": "expo export --platform android --output-dir .expo-export-check && rm -rf .expo-export-check",
    "doctor": "npx expo-doctor",
    "preview:web": "EXPO_PUBLIC_SUPABASE_URL=https://preview.matiq.invalid EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_preview_not_a_real_key expo export --platform web --output-dir dist-preview --clear",
    "brand:assets": "node scripts/brand-assets.cjs",
    "preview:walkthrough": "node scripts/preview-walkthrough.cjs dist-preview preview-screenshots",
    "preview:serve": "node -e \"require('./scripts/preview-serve.cjs')('dist-preview', 8081).then(({ url }) => console.log('UI preview at ' + url))\""
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@matiq/rules-engine": "*",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.5",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.28",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-ssl-public-key-pinning": "1.2.6",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "~19.3.0",
    "axe-core": "^4.14.0",
    "playwright": "1.63.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.4",
    "typescript": "~7.0.2"
  }
}
